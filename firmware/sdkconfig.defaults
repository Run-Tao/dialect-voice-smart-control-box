# =====================================================================
# 立创·实战派 ESP32-S3 (N16R8) —— 端云协同方言语音终端 sdkconfig.defaults
# 约束落地：
#   * 8MB Octal PSRAM 必须启用；>16KB 的连续音频/HTTP 缓冲一律落 PSRAM
#     （SPIRAM_MALLOC_ALWAYSINTERNAL=16384：<=16KB 才允许进内部 SRAM）
#   * I2S ISR 放 IRAM，防止 Flash 操作期间 DMA 中断延迟丢帧
#   * FATFS 长文件名 + UTF-8 API + 936 码页（wiki 第 6 章要求）
# =====================================================================

# --- Target / Flash ---
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- CPU / FreeRTOS ---
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# --- PSRAM (Octal 80MHz) ---
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# --- I2S：DMA/ISR 安全 ---
CONFIG_I2S_ISR_IRAM_SAFE=y

# --- SD 卡 FATFS（1-bit SDMMC, /sdcard）---
CONFIG_FATFS_SECTOR_SIZE_4096=y
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_API_ENCODING_UTF8=y
CONFIG_FATFS_CODEPAGE_936=y

# --- LVGL 8.4：16bit 色深；分配走 stdlib malloc => 自动受 PSRAM 策略约束 ---
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_LOG=n

# --- Wi-Fi / HTTP（云端为局域网 PC，HTTP 即可；保留 HTTPS 能力）---
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y

# --- 日志 ---
CONFIG_LOG_DEFAULT_LEVEL_INFO=y