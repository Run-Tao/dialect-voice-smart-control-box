    "asr": "厨房的灯条暗一点。"
  },
  {
    "id": "zh12",
    "text": "关上浴室的插座",
    "asr": "关上浴室的插座。"
  },
  {
    "id": "zh13",
    "text": "空调温度调高一度",
    "asr": "空调温度调高一度。"
  },
  {
    "id": "zh14",
    "text": "把客厅电视关掉",
    "asr": "把客厅电视关掉。"
  }
