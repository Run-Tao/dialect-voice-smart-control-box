    "asr": "冷气调到二十六度。"
  },
  {
    "id": "yue10",
    "text": "卧室冷气较到廿八度",
    "asr": "卧室冷气降到廿八度。"
  },
  {
    "id": "yue11",
    "text": "开电视",
    "asr": "开电视。"
  },
  {
    "id": "yue12",
    "text": "熄电视",
    "asr": "熄电视。"
  },
  {
    "id": "yue13",
    "text": "电视大声啲",
    "asr": "电视大声啲。"
  },
  {
    "id": "yue14",
    "text": "电视细声啲",
    "asr": "电视细声啲。"
  },
  {
    "id": "yue15",
    "text": "帮我转台",
    "asr": "帮我转台。"
  },
  {
    "id": "yue16",
    "text": "拉开客厅窗帘",
    "asr": "拉开客厅窗帘。"
  },
  {
