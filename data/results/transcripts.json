    "asr": "空调温度调低两度。"
  },
  {
    "id": "zh05",
    "text": "空调调到二十四度",
    "asr": "空调调到24度。"
  },
  {
    "id": "zh06",
    "text": "关闭窗帘",
    "asr": "关闭窗帘。"
  },
  {
    "id": "zh07",
    "text": "打开窗帘",
    "asr": "打开窗帘。"
  },
  {
    "id": "zh08",
