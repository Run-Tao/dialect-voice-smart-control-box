    "asr": "电视大声一点。"
  },
  {
    "id": "zh09",
    "text": "风扇调快一点",
    "asr": "风扇调快一点。"
  },
  {
    "id": "zh10",
    "text": "打开书房的风扇",
    "asr": "打开书房的风扇。"
  },
  {
    "id": "zh11",
