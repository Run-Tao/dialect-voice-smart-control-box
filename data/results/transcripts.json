    "asr": "熄咗冷气。"
  },
  {
    "id": "yue07",
    "text": "冷气较低两度",
    "asr": "冷气降低两度。"
  },
  {
    "id": "yue08",
    "text": "冷气调高一度",
    "asr": "冷气调高一度。"
  },
  {
    "id": "yue09",
