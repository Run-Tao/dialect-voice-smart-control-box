[
  {
    "id": "yue01",
    "text": "唔该帮我熄咗客厅盏灯",
    "asr": "唔该帮我熄咗客厅盏灯。"
  },
  {
    "id": "yue02",
    "text": "帮我开客厅盏灯",
    "asr": "帮我开客厅盏灯。"
  },
  {
    "id": "yue03",
    "text": "客厅盏灯较光啲",
    "asr": "客厅盏灯校光啲。"
  },
  {
    "id": "yue04",
    "text": "卧室灯较暗啲",
    "asr": "卧室灯校暗啲。"
  },
  {
    "id": "yue05",
    "text": "开冷气",
    "asr": "开冷气。"
  },
  {
    "id": "yue06",
