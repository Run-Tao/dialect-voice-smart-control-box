  },
  {
    "id": "yue24",
    "text": "书房灯较光啲",
    "asr": "书房灯割光啲。"
  },
  {
    "id": "yue25",
    "text": "唔该熄咗睡房盏灯",
    "asr": "唔该熄咗睡房盏灯。"
  },
  {
    "id": "yue26",
    "text": "冷气冻啲",
    "asr": "冷气冻啲。"
  },
  {
    "id": "zh01",
