    "asr": "拉埋卧室窗帘。"
  },
  {
    "id": "yue18",
    "text": "开风扇",
    "asr": "开风扇。"
  },
  {
    "id": "yue19",
    "text": "熄风扇",
    "asr": "熄风扇。"
  },
  {
    "id": "yue20",
    "text": "风扇快啲",
    "asr": "风扇快啲。"
  },
  {
    "id": "yue21",
